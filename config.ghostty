# Ghostty — ghost configuration

# --- Appearance & Theme ---
theme = light:Melange Light,dark:Melange Dark
window-show-tab-bar = never
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
unfocused-split-opacity = 0.85

# Never close a surface with a running command without asking.
confirm-close-surface = true

# --- Typography & Cursor ---
font-family = "Cascadia Code NF"
font-size = 13
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

# --- Performance & Sandboxing ---
gtk-single-instance = true
linux-cgroup-memory-limit = 8589934592
linux-cgroup-processes-limit = 8192

# --- Shaders & Visual FX ---
custom-shader = shaders/cursor_warp.glsl

# --- Shell & Workflow ---
command = zsh
scrollback-limit = 200000
copy-on-select = clipboard
split-preserve-zoom = navigation
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo

# Machine-local overrides belong in ~/.config/ghostty/local.conf (gitignored).
# `?` keeps the path optional, so a missing file is not an error.
config-file = ?local.conf

# --- Quick Terminal ---
quick-terminal-size = 45%
quick-terminal-autohide = true
keybind = ctrl+grave_accent=toggle_quick_terminal

# --- Keybindings ---
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+z=toggle_split_zoom
keybind = alt+equal=equalize_splits
keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+d=toggle_window_decorations
keybind = ctrl+shift+b=toggle_tab_overview
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+m=toggle_mouse_reporting
keybind = ctrl+alt+r=toggle_readonly
keybind = alt+u=copy_url_to_clipboard
keybind = ctrl+alt+e=write_scrollback_file:open
